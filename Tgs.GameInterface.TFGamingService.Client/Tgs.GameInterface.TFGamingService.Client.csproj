<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.7</Version>
    <Authors>Raypro</Authors>
    <Description>Tgs.GameInterface.TFGamingService.Client</Description>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-tfgamingservice</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-tfgamingservice.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Tgs GameInterface TFGamingService</PackageTags>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.55.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.55.0" />
		<PackageReference Include="Grpc.Tools" Version="2.56.2">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
	  <Protobuf Include="..\Tgs.GameInterface.TFGamingService\Protos\gameinterfacetfgamingservice.proto">
	    <Link>gameinterfacetfgamingservice.proto</Link>
	  </Protobuf>
	</ItemGroup>

</Project>
