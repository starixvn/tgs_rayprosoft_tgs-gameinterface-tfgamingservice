<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.2</Version>
    <Authors>Raypro</Authors>
    <Description>Tgs.GameInterface.TFGamingService.Client</Description>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-tfgamingservice</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-tfgamingservice.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Tgs GameInterface TFGamingService</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="gameinterfacetfgamingservice.proto" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.49.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.49.0" />
		<PackageReference Include="Grpc.Tools" Version="2.50.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>


	<ItemGroup>
	  <Protobuf Include="gameinterfacetfgamingservice.proto">
	    <GrpcServices>Client</GrpcServices>
	  </Protobuf>
	</ItemGroup>

</Project>
